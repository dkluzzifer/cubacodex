{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "CubaCodex",
  "version": "1.0.0",
  "identifier": "com.cubacodex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "CubaCodex",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CubaCodex",
    "copyright": "Copyright 2025 CubaCodex Contributors",
    "category": "Developer Tool",
    "shortDescription": "IDE de código asistido por IA",
    "longDescription": "CubaCodex es un entorno de desarrollo integrado (IDE) con inteligencia artificial integrada para ayudar a programadores a escribir código más rápido y eficiente.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languageSelectorMode": "languageList",
        "allowDowngrades": false,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHeader": "icons/icon.ico",
        "perMachine": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "es-ES"
      }
    }
  },
  "plugins": {
    "dialog": "all",
    "fs": "all",
    "store": "all"
  }
}
